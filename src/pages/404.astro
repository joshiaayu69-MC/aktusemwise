---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you are looking for does not exist. Browse courses, subjects, tools, or search the site."
  noindex
>
  <section class="container-page py-20 md:py-28" data-pagefind-ignore>
    <p class="font-condensed text-xs font-bold uppercase tracking-[0.14em] text-stone-500">
      404
    </p>
    <h1 class="mt-3 max-w-2xl font-display text-4xl font-light tracking-[-0.03em] text-stone-950 md:text-6xl">
      That page is not here.
    </h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-stone-600">
      The link may be old, or the resource may have moved. Try a course, a subject hub, or
      search the site.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/courses/"
        class="inline-flex h-11 items-center justify-center rounded-full bg-stone-950 px-5 text-base font-medium text-white hover:bg-stone-700"
      >
        Browse courses
      </a>
      <a
        href="/search/"
        class="inline-flex h-11 items-center justify-center rounded-full border border-stone-300 bg-white px-5 text-base font-medium text-stone-900 shadow-hairline hover:bg-stone-50"
      >
        Search
      </a>
      <a
        href="https://aktu.ac.in/"
        rel="noopener"
        target="_blank"
        class="inline-flex h-11 items-center justify-center rounded-full border border-stone-300 bg-white px-5 text-base font-medium text-stone-900 shadow-hairline hover:bg-stone-50"
      >
        Official AKTU site
      </a>
    </div>
  </section>
</BaseLayout>
