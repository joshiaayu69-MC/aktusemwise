---
import EmptyState from '../../components/EmptyState.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedBlogPosts } from '../../lib/content';
import { blogUrl } from '../../lib/urls';

const posts = await getPublishedBlogPosts();

const breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'Updates' }];
---

<BaseLayout
  title="AKTU exam updates and study notes"
  description="Plain-language AKTU updates, exam preparation guides, and study notes with official sources linked."
  breadcrumbs={breadcrumbs}
  noindex={posts.length === 0}
>
  <PageHero
    eyebrow="Updates"
    title="Exam updates and study notes"
    description="Short, sourced posts about AKTU circulars, results, datesheets, and preparation. Every factual claim links to the official source."
    breadcrumbs={breadcrumbs}
  />

  <div class="container-page py-10 md:py-14">
    {posts.length > 0 ? (
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="flex h-full flex-col rounded-card-lg border border-stone-200 bg-white p-5 shadow-lift">
            <p class="text-xs text-stone-500">
              {new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium' }).format(
                post.data.published,
              )}
              {post.data.draft ? ' · Draft' : ''}
            </p>
            <h2 class="mt-2 font-display text-xl leading-snug text-stone-950">
              <a href={blogUrl(post.id)} class="hover:underline">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-stone-600">
              {post.data.description}
            </p>
            <div class="mt-auto flex flex-wrap gap-2 pt-4">
              {post.data.tags.slice(0, 3).map((tag) => (
                <span class="rounded-full bg-cream px-2.5 py-1 text-xs text-stone-600">
                  {tag}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <EmptyState
        title="No published updates yet"
        description="We publish an update only when the official notice has been checked. Use the official AKTU website for live notices."
        actionHref="https://aktu.ac.in/"
        actionLabel="Open AKTU website"
      />
    )}
  </div>
</BaseLayout>
