---
import EmptyState from '../../../components/EmptyState.astro';
import PageHero from '../../../components/PageHero.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getSubjectsFor } from '../../../lib/content';
import { buildCourse } from '../../../lib/schema';
import { SITE } from '../../../lib/site';
import { courses, getBranchesForCourse, getSemesterNumbers } from '../../../lib/taxonomy';
import { branchUrl, courseUrl, semesterUrl } from '../../../lib/urls';

export async function getStaticPaths() {
  return courses.flatMap((course) =>
    getBranchesForCourse(course.slug).map((branch) => ({
      params: { course: course.slug, branch: branch.slug },
      props: { course, branch },
    })),
  );
}

const { course, branch } = Astro.props;

const semesterSummaries = await Promise.all(
  getSemesterNumbers(course.slug).map(async (semester) => ({
    semester,
    subjects: await getSubjectsFor(course.slug, branch.slug, semester),
  })),
);

const totalSubjects = semesterSummaries.reduce(
  (total, summary) => total + summary.subjects.length,
  0,
);

const siteUrl = (Astro.site ?? new URL(SITE.url)).toString();

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Courses', href: '/courses/' },
  { label: course.name, href: courseUrl(course.slug) },
  { label: branch.name },
];

const jsonLd = [
  buildCourse({
    name: `${branch.full_name} (${course.full_name})`,
    description: `Semester-wise AKTU study resources for ${branch.full_name}, ${course.full_name}.`,
    url: branchUrl(course.slug, branch.slug),
    siteUrl,
  }),
];
---

<BaseLayout
  title={`${branch.name} ${course.name} notes, syllabus and papers`}
  description={`Semester-wise syllabus, original notes, solved papers, and question banks for ${branch.full_name} (${course.full_name}) at AKTU.`}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
  noindex={totalSubjects === 0}
>
  <PageHero
    eyebrow={`${course.name} · ${branch.name}`}
    title={`${branch.name} study resources`}
    description={`Choose a semester to see subject hubs for ${branch.full_name}. Notes, papers, and tools are added only after verification and human review.`}
    breadcrumbs={breadcrumbs}
  />

  <div class="container-page py-10 md:py-14">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="font-display text-2xl text-stone-950">Semesters</h2>
        <p class="mt-1 text-sm text-stone-600">
          {course.semesters} semesters · {totalSubjects} published subjects
        </p>
      </div>
      <a
        href="https://aktu.ac.in/syllabus.html"
        rel="noopener"
        target="_blank"
        class="inline-flex h-10 items-center rounded-full border border-stone-300 bg-white px-4 text-sm font-medium text-stone-900 shadow-hairline hover:bg-stone-50"
      >
        Official syllabus
      </a>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {semesterSummaries.map(({ semester, subjects }) => (
        <a
          href={semesterUrl(course.slug, branch.slug, semester)}
          class="group rounded-card border border-stone-200 bg-white p-4 shadow-lift transition-colors hover:border-stone-300"
        >
          <p class="font-condensed text-xs font-bold uppercase tracking-[0.12em] text-stone-500">
            Semester
          </p>
          <p class="mt-1 font-display text-3xl text-stone-950">{semester}</p>
          <p class="mt-1 text-xs text-stone-500">
            {subjects.length === 0
              ? 'Content in progress'
              : `${subjects.length} ${subjects.length === 1 ? 'subject' : 'subjects'}`}
          </p>
          <span class="mt-3 inline-block text-sm font-medium text-accent-strong group-hover:underline">
            Open →
          </span>
        </a>
      ))}
    </div>

    {totalSubjects === 0 && (
      <div class="mt-10">
        <EmptyState
          title="Subject hubs for this branch are being prepared"
          description="We do not publish empty subject pages. Use the official syllabus now; verified subject hubs will appear as resources are reviewed."
          actionHref="https://aktu.ac.in/syllabus.html"
          actionLabel="Open official syllabus"
        />
      </div>
    )}
  </div>
</BaseLayout>
