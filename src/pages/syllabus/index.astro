---
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedSubjects } from '../../lib/content';
import { courses, getBranchesForCourse, schemes } from '../../lib/taxonomy';
import { subjectUrl } from '../../lib/urls';

const subjects = await getPublishedSubjects();

const breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'Syllabus' }];
---

<BaseLayout
  title="AKTU Official Syllabus & Evaluation Schemes (B.Tech All Branches)"
  description="Explore verified AKTU syllabus, evaluation schemes, and unit-wise topic lists for B.Tech CSE, IT, ECE, EE, ME, Civil. Aligned with official AICTE/NEP curriculum."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="Academic Curriculum"
    title="AKTU Syllabus & Evaluation Schemes"
    description="Access verified unit-wise syllabus outlines, credit structures, and official university curriculum guidelines. Every subject mapped to official AKTU documents."
    breadcrumbs={breadcrumbs}
  />

  <div class="container-page py-10 md:py-14">
    <!-- Scheme Overview -->
    <section class="mb-12">
      <div class="border-b border-stone-200 pb-3">
        <h2 class="font-display text-2xl text-stone-950">Active Evaluation Schemes</h2>
        <p class="mt-1 text-sm text-stone-600">
          AKTU organizes academic study under standard evaluation schemes with specific
          credit requirements.
        </p>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {schemes.map((scheme) => (
          <div class="rounded-card border border-stone-200 bg-white p-5 shadow-hairline">
            <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-800">
              Active Curriculum
            </span>
            <h3 class="mt-3 font-display text-lg text-stone-950">{scheme.label}</h3>
            <p class="mt-1 text-xs text-stone-500">Scheme ID: {scheme.slug}</p>
            <p class="mt-3 text-xs leading-relaxed text-stone-600">
              Follows CBCS (Choice Based Credit System) with standardized internal
              sessional (30 marks) and external end-semester theory (70 marks)
              assessments.
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Verified Subject Syllabi -->
    <section class="mb-12">
      <div class="border-b border-stone-200 pb-3">
        <h2 class="font-display text-2xl text-stone-950">
          Verified Subject Syllabi & Unit Outlines
        </h2>
        <p class="mt-1 text-sm text-stone-600">
          Explore complete unit breakdowns, lecture hours, and topic coverage for core
          engineering subjects.
        </p>
      </div>

      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {subjects.map((sub) => (
          <article class="rounded-card border border-stone-200 bg-white p-5 shadow-lift transition-colors hover:border-stone-300">
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-xs font-semibold text-accent-strong">
                {sub.data.code}
              </span>
              <span class="rounded-full bg-cream px-2 py-0.5 text-[11px] font-medium text-stone-700">
                Sem {sub.data.semester} · {sub.data.credits} Credits
              </span>
            </div>

            <h3 class="mt-3 font-display text-lg text-stone-950 leading-snug">
              {sub.data.name}
            </h3>

            <div class="mt-3 space-y-1.5 text-xs text-stone-600">
              <p>
                <strong>Units:</strong> {sub.data.syllabus_units.length} verified units
              </p>
              <p>
                <strong>Branches:</strong> {sub.data.branches.join(', ').toUpperCase()}
              </p>
            </div>

            <div class="mt-5 pt-3 border-t border-stone-100 flex items-center justify-between text-xs">
              <a
                href={subjectUrl(sub.data.code)}
                class="font-semibold text-stone-950 hover:underline"
              >
                View Syllabus Breakdown →
              </a>
              <a
                href={sub.data.source_url}
                target="_blank"
                rel="noopener"
                class="text-stone-500 hover:text-stone-800"
              >
                Official PDF ↗
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Branch Directory -->
    <section class="rounded-card-lg border border-stone-200 bg-cream p-6">
      <h2 class="font-display text-xl text-stone-950">
        Branch-Wise Syllabus Repositories
      </h2>
      <p class="mt-2 text-sm text-stone-600">
        Choose your engineering discipline to view semester-by-semester course plans and
        syllabus guidelines.
      </p>
      <div class="mt-5 grid gap-3 sm:grid-cols-2 md:grid-cols-4">
        {getBranchesForCourse('btech').map((branch) => (
          <a
            href={`/btech/${branch.slug}/`}
            class="rounded-card border border-stone-200/80 bg-white p-3.5 shadow-hairline transition-colors hover:border-stone-400"
          >
            <span class="block font-display text-base font-medium text-stone-950">
              {branch.name}
            </span>
            <span class="block text-xs text-stone-500">{branch.full_name}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
