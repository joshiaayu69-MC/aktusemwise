---
import EmptyState from '../../components/EmptyState.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedBlogPosts } from '../../lib/content';
import { blogUrl } from '../../lib/urls';

const posts = await getPublishedBlogPosts();

const breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'Updates & Circulars' }];
---

<BaseLayout
  title="AKTU Updates, Circulars & Exam Notifications | Latest News"
  description="Stay informed with verified AKTU circulars, exam date sheets, admit card updates, grace marks policies, and evaluation guidelines explained in plain English."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="University Notices"
    title="AKTU Updates & Circulars"
    description="Official university notices, examination circulars, evaluation rules, and admit card updates translated into clear, actionable student guides. Every fact verified."
    breadcrumbs={breadcrumbs}
  />

  <div class="container-page py-10 md:py-14">
    <!-- Notice Bar -->
    <div class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-card border border-amber-200/80 bg-amber-50/60 p-4 text-xs text-amber-900">
      <div class="flex items-center gap-2">
        <span class="flex size-2 rounded-full bg-amber-600 animate-pulse"></span>
        <span class="font-medium">Direct University Portals:</span>
        <span>
          Check your official enrollment status, admit card, and results directly at
          official domains.
        </span>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="https://erp.aktu.ac.in/"
          target="_blank"
          rel="noopener"
          class="font-semibold underline hover:text-amber-950"
        >
          AKTU ERP ↗
        </a>
        <a
          href="https://aktu.ac.in/"
          target="_blank"
          rel="noopener"
          class="font-semibold underline hover:text-amber-950"
        >
          Official Circulars ↗
        </a>
      </div>
    </div>

    <!-- Posts Grid -->
    {posts.length > 0 ? (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="flex h-full flex-col rounded-card-lg border border-stone-200/90 bg-white p-5 shadow-lift transition-colors hover:border-stone-400">
            <div class="flex items-center justify-between gap-2 text-xs text-stone-500">
              <time datetime={post.data.published.toISOString()}>
                {new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium' }).format(
                  post.data.published,
                )}
              </time>
              {post.data.verified && (
                <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-800">
                  Verified Notice
                </span>
              )}
            </div>

            <h2 class="mt-3 font-display text-xl leading-snug text-stone-950">
              <a href={blogUrl(post.id)} class="hover:underline">
                {post.data.title}
              </a>
            </h2>

            <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-stone-600">
              {post.data.description}
            </p>

            <div class="mt-auto pt-5">
              <div class="flex flex-wrap gap-1.5 border-t border-stone-100 pt-3">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="rounded-full bg-cream px-2.5 py-0.5 text-xs text-stone-600">
                    #{tag}
                  </span>
                ))}
              </div>
              <a
                href={blogUrl(post.id)}
                class="mt-3 inline-flex items-center text-xs font-semibold text-stone-950 hover:underline"
              >
                Read Full Guide →
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <EmptyState
        title="No published updates yet"
        description="We publish updates only after checking the official university document. Use the official AKTU portal for live notifications."
        actionHref="https://aktu.ac.in/"
        actionLabel="Open Official AKTU Website"
      />
    )}
  </div>
</BaseLayout>
