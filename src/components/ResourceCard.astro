---
import type { Resource } from '../lib/schemas';
import { SITE } from '../lib/site';
import Badge from './Badge.astro';

type Props = {
  resource: Resource;
};

const { resource } = Astro.props;

const typeLabels: Record<Resource['type'], string> = {
  notes: 'Notes',
  pyq: 'Previous year paper',
  solution: 'Solved paper',
  'model-paper': 'Model paper',
  'question-bank': 'Question bank',
  'lab-file': 'Lab file',
  viva: 'Viva questions',
  syllabus: 'Syllabus',
  'important-questions': 'Important questions',
};

const licenceLabels: Record<Resource['licence'], string> = {
  'site-original': 'Original',
  'cc0-1.0': 'CC0',
  'public-domain': 'Public domain',
  'cc-by-4.0': 'CC BY 4.0',
  'cc-by-sa-4.0': 'CC BY-SA 4.0',
  'godl-1.0': 'GODL-India',
  'permission-granted': 'Permission granted',
};

const fileUrl = resource.r2_key
  ? `${SITE.filesUrl.replace(/\/$/, '')}/${resource.r2_key}`
  : undefined;

const updated = resource.updated
  ? new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium' }).format(resource.updated)
  : undefined;
---

<article class="rounded-card border border-stone-200/80 bg-white p-5 shadow-lift">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <Badge tone="accent">{typeLabels[resource.type]}</Badge>
        <Badge tone="neutral">{licenceLabels[resource.licence]}</Badge>
        {resource.verified ? (
          <Badge tone="success">Verified</Badge>
        ) : (
          <Badge tone="warning">Under review</Badge>
        )}
      </div>
      <h3 class="mt-3 font-display text-lg font-normal leading-snug text-stone-950">
        {resource.title}
      </h3>
    </div>
  </div>

  {resource.description && (
    <p class="mt-2 text-sm leading-relaxed text-stone-600">{resource.description}</p>
  )}

  <dl class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-stone-500">
    {resource.pages ? (
      <div class="flex gap-1">
        <dt class="sr-only">Pages</dt>
        <dd>{resource.pages} pages</dd>
      </div>
    ) : null}
    {resource.size_mb ? (
      <div class="flex gap-1">
        <dt class="sr-only">File size</dt>
        <dd>{resource.size_mb.toFixed(1)} MB</dd>
      </div>
    ) : null}
    {updated ? (
      <div class="flex gap-1">
        <dt class="sr-only">Updated</dt>
        <dd>Updated {updated}</dd>
      </div>
    ) : null}
    {resource.unit ? (
      <div class="flex gap-1">
        <dt class="sr-only">Unit</dt>
        <dd>Unit {resource.unit}</dd>
      </div>
    ) : null}
  </dl>

  <div class="mt-5">
    {fileUrl ? (
      <a
        href={fileUrl}
        class="inline-flex h-10 items-center justify-center rounded-full bg-stone-950 px-4 text-sm font-medium text-white transition-colors duration-200 hover:bg-stone-700 active:scale-[0.98]"
        rel="noopener"
      >
        Download PDF
      </a>
    ) : resource.official_url ? (
      <a
        href={resource.official_url}
        class="inline-flex h-10 items-center justify-center rounded-full border border-stone-300 bg-white px-4 text-sm font-medium text-stone-900 shadow-hairline transition-colors duration-200 hover:bg-stone-50"
        rel="noopener"
        target="_blank"
      >
        {resource.type === 'pyq'
          ? 'View Official Question Paper →'
          : resource.type === 'syllabus'
            ? 'View Official Syllabus →'
            : 'Official source →'}
      </a>
    ) : (
      <span class="inline-flex h-10 items-center rounded-full bg-stone-100 px-4 text-sm font-medium text-stone-500">
        Resource in preparation
      </span>
    )}
  </div>
</article>
