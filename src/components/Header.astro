---
import { SITE } from '../lib/site';

const pathname = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
}
---

<header
  class="sticky top-0 z-40 border-b border-stone-200/80 bg-eggshell/90 backdrop-blur"
  data-pagefind-ignore
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="flex items-center gap-2 rounded-full py-1 pr-2 text-stone-950 focus-visible:outline-accent"
      aria-label={`${SITE.name} home`}
    >
      <span
        class="grid size-9 place-items-center rounded-full bg-stone-950 text-stone-50"
        aria-hidden="true"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v18H6.5A2.5 2.5 0 0 1 4 18.5z"></path>
          <path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20"></path>
          <path d="M8 7h8M8 11h5"></path>
        </svg>
      </span>
      <span class="leading-tight">
        <span class="block font-display text-lg tracking-tight">{SITE.name}</span>
        <span class="block font-condensed text-[10px] font-bold uppercase tracking-[0.16em] text-stone-500">
          Study resources
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {SITE.nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-full px-3 py-2 text-sm font-medium transition-colors duration-150',
            isActive(item.href)
              ? 'bg-stone-100 text-stone-950'
              : 'text-stone-600 hover:bg-stone-100 hover:text-stone-950',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/btech/"
        class="hidden h-10 items-center justify-center rounded-full bg-stone-950 px-4 text-sm font-medium text-white transition-colors duration-200 hover:bg-stone-700 active:scale-[0.98] sm:inline-flex"
      >
        Browse B.Tech
      </a>

      <details class="relative md:hidden">
        <summary class="flex h-10 cursor-pointer list-none items-center gap-2 rounded-full border border-stone-200 bg-white px-4 text-sm font-medium text-stone-900 shadow-hairline [&::-webkit-details-marker]:hidden">
          Menu
          <svg
            viewBox="0 0 20 20"
            class="size-4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h12M4 13h12"></path>
          </svg>
        </summary>
        <div class="absolute right-0 mt-2 w-60 rounded-card border border-stone-200 bg-white p-2 shadow-overlay">
          <nav aria-label="Mobile">
            <ul class="space-y-1">
              {SITE.nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      'block rounded-input px-3 py-2.5 text-sm font-medium',
                      isActive(item.href)
                        ? 'bg-stone-100 text-stone-950'
                        : 'text-stone-700 hover:bg-stone-100',
                    ]}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
              <li class="pt-1">
                <a
                  href="/btech/"
                  class="block rounded-input bg-stone-950 px-3 py-2.5 text-center text-sm font-medium text-white"
                >
                  Browse B.Tech
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
