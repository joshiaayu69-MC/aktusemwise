---
import type { SubjectEntry } from '../lib/content';
import { getScheme } from '../lib/taxonomy';
import { subjectUrl } from '../lib/urls';
import Badge from './Badge.astro';

type Props = {
  subject: SubjectEntry;
};

const { subject } = Astro.props;
const data = subject.data;
const scheme = getScheme(data.scheme);
const resourceCount = data.resources.length;
---

<article class="group flex h-full flex-col rounded-card-lg border border-stone-200/80 bg-white p-5 shadow-lift transition-colors duration-200 hover:border-stone-300">
  <div class="flex flex-wrap items-center gap-2">
    <span class="font-mono text-xs font-medium tracking-tight text-stone-500">
      {data.code}
    </span>
    <Badge tone="neutral">Sem {data.semester}</Badge>
    {data.verified ? (
      <Badge tone="success">Verified</Badge>
    ) : (
      <Badge tone="warning">Under review</Badge>
    )}
  </div>

  <h3 class="mt-3 font-display text-xl font-normal leading-snug tracking-tight text-stone-950">
    <a
      href={subjectUrl(data.code)}
      class="rounded-sm decoration-stone-300 underline-offset-4 group-hover:underline"
    >
      {data.name}
    </a>
  </h3>

  <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-stone-600">
    {data.description}
  </p>

  <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-5 text-xs text-stone-500">
    <span>{scheme?.label ?? data.scheme}</span>
    <span aria-hidden="true">·</span>
    <span>
      {resourceCount} {resourceCount === 1 ? 'resource' : 'resources'}
    </span>
    {data.credits ? (
      <>
        <span aria-hidden="true">·</span>
        <span>{data.credits} credits</span>
      </>
    ) : null}
  </div>
</article>
