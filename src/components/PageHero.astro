---
import type { BreadcrumbItem } from '../lib/schema';
import Breadcrumbs from './Breadcrumbs.astro';

type Props = {
  eyebrow?: string;
  title: string;
  description?: string;
  breadcrumbs?: BreadcrumbItem[];
};

const { eyebrow, title, description, breadcrumbs } = Astro.props;
---

<section class="border-b border-stone-200 bg-cream/60">
  <div class="container-page py-10 md:py-14">
    {breadcrumbs && breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
    {eyebrow && (
      <p class="mt-5 font-condensed text-xs font-bold uppercase tracking-[0.12em] text-stone-500">
        {eyebrow}
      </p>
    )}
    <h1 class="mt-3 max-w-4xl font-display text-hero font-light tracking-[-0.02em] text-stone-950 md:text-5xl">
      {title}
    </h1>
    {description && (
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-600 md:text-lg">
        {description}
      </p>
    )}
    <slot />
  </div>
</section>
