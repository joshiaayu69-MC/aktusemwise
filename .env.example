# AI provider for scripts/ai-extract.ts and scripts/ai-author.ts.
# Use any OpenAI-compatible chat-completions endpoint. Never commit real keys.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Cloudflare (optional; prefer `npx wrangler login` or CI secrets).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Public site settings used by build-time scripts (optional).
SITE_URL=https://yourbrand.in
FILES_URL=https://files.yourbrand.in
